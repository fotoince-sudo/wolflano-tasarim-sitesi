# Wolflano – TurkHosting (Plesk/Apache) ayarları
Options -Indexes

# Siteyle ilgisi olmayan dosyaları dışarıya kapat
RedirectMatch 404 ^/(supabase|okul-robot|\.git|\.github)(/.*)?$
<FilesMatch "^(wrangler\.jsonc|README\.md|\.assetsignore|\.htaccess)$">
  Require all denied
</FilesMatch>

RewriteEngine On
# www → wolflano.com.tr
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# http → https (Cloudflare proxy arkasında da çalışır)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP:CF-Visitor} !"scheme":"https"
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Eski / değişmiş adresler (yayında otomatik yazılır)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/(?!studyo\.html|google[0-9a-f]+\.html)([^?\s]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteRule ^(shop|magaza|urunler)/?$ /hazir-urunler [R=301,L]
RewriteRule ^(product|product-category|urun-kategori|kategori-urun)/ /hazir-urunler [R=301,L]
RewriteRule ^(cart|sepet|checkout|odeme|my-account|hesabim)/?$ / [R=301,L]
RewriteRule ^urun/(?!cocuk-tisort-cocuk-wolf-6-nmwccb5mewelwe$)[^/]*-nmwccb5mewelwe/?$ /urun/cocuk-tisort-cocuk-wolf-6-nmwccb5mewelwe [R=301,L]
